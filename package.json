{
  "name": "job-tracker-root",
  "version": "1.0.0",
  "private": true,
  "description": "Job Tracker full-stack application (FastAPI + Next.js 15)",
  "scripts": {
    "dev": "python run.py",
    "backend": "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir . --reload --port 8000",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "backend\\.venv\\Scripts\\python.exe -m pytest backend\\tests"
  }
}

